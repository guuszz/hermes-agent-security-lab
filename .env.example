# Used only from the M1 provider integration onward. Never commit a real value.
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=tencent/hy3
ORCAROUTER_MAX_TOKENS=1600
ORCAROUTER_TEMPERATURE=0.2
ORCAROUTER_TIMEOUT_MS=60000
ORCAROUTER_MAX_ATTEMPTS=3
ORCAROUTER_RETRY_AFTER_CAP_MS=60000

# Exact opt-in required by `npm run smoke:orcarouter`.
HERMES_PAID_SMOKE_CONFIRM=
