{
  "name": "hermes-agent-security-lab",
  "version": "0.1.0",
  "scripts": {
    "test": "node --import tsx --test test/**/*.test.ts",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "cybersecurity",
    "agentic-ai",
    "red-team",
    "owasp"
  ],
  "author": "Gustavo Oliveira",
  "license": "MIT",
  "description": "Reproducible security lab for tool-using AI agents",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hermes-lab": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/guuszz/hermes-agent-security-lab.git"
  },
  "bugs": {
    "url": "https://github.com/guuszz/hermes-agent-security-lab/issues"
  },
  "homepage": "https://github.com/guuszz/hermes-agent-security-lab#readme"
}
